# Application
APP_SECRET_KEY=replace-with-output-from-python-secrets-token-hex-32
ACCESS_TOKEN_MINUTES=30
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Docker only. Generate non-default passwords; do not reuse these in production.
POSTGRES_DB=whatsapp_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-database-password

# Database (internal Docker network uses 5432, host port is 5433)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis (internal Docker network uses 6379, host port is 6380)
REDIS_URL=redis://redis:6379/0

# Encryption (for credential storage) - generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-output-from-python-fernet-generate-key

# WhatsApp (optional for development)
WHATSAPP_MOCK_MODE=true
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# AI (optional)
OPENAI_API_KEY=
AI_PROVIDER=mock

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
